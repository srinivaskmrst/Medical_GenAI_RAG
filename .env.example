# =========================================================
# Medical GenAI RAG Platform — Environment Configuration
# Copy this file to .env and adjust values as needed.
# =========================================================

# ---------------------------------------------------------
# App
# ---------------------------------------------------------
APP_NAME=medical-rag
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------
# Qdrant (Vector Database)
# ---------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_USE_GRPC=false
QDRANT_COLLECTION=medical_knowledge
QDRANT_API_KEY=

# ---------------------------------------------------------
# Ollama (Local LLM Runtime)
# No model is hard-coded — set to whatever you have pulled
# locally, e.g. `ollama pull llama3.1` or `ollama pull qwen2.5`
# ---------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1

# ---------------------------------------------------------
# Embedding Model (local Sentence Transformers)
# ---------------------------------------------------------
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------
# Chunking
# ---------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---------------------------------------------------------
# Retrieval
# ---------------------------------------------------------
TOP_K=10
RERANK_TOP_K=5
SCORE_THRESHOLD=0.3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# ---------------------------------------------------------
# Grounding
# ---------------------------------------------------------
GROUNDING_MIN_CONFIDENCE=0.5

# ---------------------------------------------------------
# API
# ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
