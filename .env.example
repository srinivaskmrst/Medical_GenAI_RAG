# =========================================================
# Medical GenAI RAG Platform — Environment Configuration
# Copy this file to .env and adjust values as needed.
# =========================================================

# ---------------------------------------------------------
# App
# ---------------------------------------------------------
APP_NAME=medical-rag
APP_ENV=local
LOG_LEVEL=INFO

# ---------------------------------------------------------
# Qdrant (Vector Database)
# QDRANT_ENDPOINT + QDRANT_API_KEY (Qdrant Cloud) are used when set.
# QDRANT_MODE=embedded is a local-disk fallback (no Docker/cloud
# needed) used only if QDRANT_ENDPOINT is left empty.
# ---------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_USE_GRPC=false
QDRANT_MODE=embedded
QDRANT_PATH=./data/qdrant_storage
QDRANT_COLLECTION=Medical_Main_memory
QDRANT_CACHE_COLLECTION=Medical_Cache_memory
QDRANT_API_KEY=
QDRANT_ENDPOINT=

# ---------------------------------------------------------
# Semantic answer cache (Medical_Cache_memory collection)
# ---------------------------------------------------------
CACHE_ENABLED=true
CACHE_SIMILARITY_THRESHOLD=0.92

# ---------------------------------------------------------
# Ollama (Local LLM Runtime)
# No model is hard-coded — set to whatever you have pulled
# locally, e.g. `ollama pull llama3.1` or `ollama pull qwen2.5`
# ---------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_REQUEST_TIMEOUT=120
OLLAMA_TEMPERATURE=0.1

# ---------------------------------------------------------
# Embedding Model
# EMBEDDING_PROVIDER=local uses fully-offline Sentence Transformers
# (384 dimensions). EMBEDDING_PROVIDER=google uses the Gemini
# embeddings API (GOOGLE_API_KEY required, 3072 dimensions) — only
# use this if your Qdrant collections were provisioned at 3072 dims.
# ---------------------------------------------------------
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
GOOGLE_API_KEY=
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# ---------------------------------------------------------
# Chunking
# ---------------------------------------------------------
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# ---------------------------------------------------------
# Retrieval
# ---------------------------------------------------------
TOP_K=10
RERANK_TOP_K=5
SCORE_THRESHOLD=0.3
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_ENABLED=true

# ---------------------------------------------------------
# Grounding
# ---------------------------------------------------------
GROUNDING_MIN_CONFIDENCE=0.5

# ---------------------------------------------------------
# API
# ---------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
